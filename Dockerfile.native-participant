FROM python:3.12.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends git libgl1 libx11-6 libxt6 libxrender1 libxext6 libsm6 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-native-participant.txt .
RUN python -m pip install --no-cache-dir -r requirements-native-participant.txt
COPY . .
# Pass scripts/ahmedml.py or scripts/windsorml.py followed by its arguments.
ENTRYPOINT ["python"]
CMD ["scripts/ahmedml.py", "--help"]
