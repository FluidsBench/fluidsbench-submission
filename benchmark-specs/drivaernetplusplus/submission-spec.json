{
  "schema_version": "1.1",
  "dataset_id": "drivaernetplusplus",
  "dataset_name": "DrivAerNet++",
  "dataset_version": "prototype-1",
  "status": "prototype_dummy_data",
  "scoring_support": {
    "status": "owner_review_required",
    "submissions_open": false,
    "closed_reason": "Submissions are currently closed.",
    "coverage_contract": {
      "dimensionality": "3D surface pressure; other supports pending",
      "rule": "complete_original_public_release_entities",
      "inference_may_be_chunked": true,
      "chunk_metrics_must_use_additive_sufficient_statistics": true,
      "complete_case_and_entity_coverage_required": true,
      "full_prediction_artifact_required": false,
      "case_aggregation": "calculate_each_case_then_macro_average_cases_equally",
      "public_ground_truth": "Ground-truth fields are in the public dataset release."
    },
    "public_supports": [
      {
        "id": "surface-pressure-native",
        "public_file": "SurfacePressureVTK/DrivAer_<design>.vtk in Harvard Dataverse doi:10.7910/DVN/K7PWNJ version 1.0",
        "format": "legacy VTK PolyData surface mesh",
        "domain": "three_dimensional_vehicle_surface",
        "association": "PointData",
        "entities": "all_native_surface_points",
        "arrays": [
          "p"
        ],
        "units_note": "Owner statement (M. Elrefaie, 2026-08-18): PointData array p stores kinematic pressure in m^2/s^2 (static pressure divided by density) from incompressible OpenFOAM v11 simpleFoam with k-omega SST at U_inf = 30 m/s, rho = 1.184 kg/m^3, nu = 1.56e-5 m^2/s; the kinematic dynamic head 0.5*U_inf^2 is 450 m^2/s^2. Dimensional metrics may be enabled later under this convention.",
        "physical_weight": "mass_lumped_dual_surface_area",
        "verification": "confirmed_by_official_loader",
        "case_file_rule": "case ID <ID> maps to SurfacePressureVTK/DrivAer_<ID>.vtk (prepend DrivAer_, append .vtk)",
        "source_pins": {
          "dataverse_doi": "doi:10.7910/DVN/K7PWNJ",
          "dataverse_version": "1.0",
          "access_route": "Harvard Dataverse (Globus-backed storage)",
          "data_licence": "CC BY-NC 4.0",
          "code_licence": "MIT",
          "splits_repository": "https://github.com/Mohamedelrefaie/DrivAerNet",
          "splits_commit": "8b8c053053aa0f27c30f73af00be070a20205858",
          "loader_of_record": "RegDGCNN_SurfaceFields/data_loader.py",
          "paper": "https://arxiv.org/abs/2406.09624",
          "splits_path": "train_val_test_splits/{train,val,test}_design_ids.txt",
          "splits_url": "https://github.com/Mohamedelrefaie/DrivAerNet/tree/main/train_val_test_splits",
          "benchmark_repository": "https://github.com/Mohamedelrefaie/CarBench",
          "benchmark_evaluation_status": "CarBench is the reference surface-pressure benchmark for this dataset. Its evaluation code and models are not yet public (the repository currently publishes the benchmark description only); the official split files will also be mirrored there after the CarBench release. CarBench reports equal-point-weighted relative L2, which corresponds to this dataset's surface_pressure_equal_entity_rel_l2 diagnostic rather than the area-weighted primary metric, so published CarBench values must be recalculated before use as leaderboard rows."
        }
      },
      {
        "id": "future-wss-and-flow-domain",
        "public_file": "Dataverse WSS doi:10.7910/DVN/PCZYL4 version 2.0 and full CFD doi:10.7910/DVN/EEYHUA version 1.0",
        "format": "VTK archives",
        "domain": "future_surface_and_three_dimensional_flow_domain",
        "association": "pending_owner_inspection",
        "entities": "not_active_until_one_official_file_from_each_archive_is_inspected",
        "physical_weight": "pending_association_confirmation",
        "verification": "owner_review_required",
        "owner_note": "WSS surface files share coordinates with the pressure files but store points in a different (permuted) order; activating any joint pressure+WSS support requires a reviewed deterministic index-matching or resampling rule before it can be scored."
      }
    ],
    "relative_l2_policy": {
      "surface_or_curve_primary": "physical_measure_weighted",
      "surface_or_curve_secondary": "equal_native_entity",
      "flow_domain_primary": "equal_native_entity",
      "flow_domain_secondary": "physical_measure_weighted",
      "point_or_vertex_physical_weights": "deterministic_mass_lumped_dual_measure_from_the_exact_public_mesh",
      "vector_rule": "one_entity_weight_multiplies_the_squared_vector_magnitude",
      "chunk_rule": "sum_numerators_and_denominators_across_chunks_then_take_one_square_root"
    },
    "owner_decisions_required": [
      "publish_immutable_scoring_support_release_with_manifest_hashes_and_dual_area_weights",
      "run_publisher_on_official_dataverse_files_and_record_publication_validation",
      "define_and_validate_profile_station_ground_truth_extraction",
      "confirm_or_retire_pending_wall_shear_and_volume_supports",
      "record_final_owner_approval_with_pull_request"
    ]
  },
  "evaluation_reference_version": "prototype-1",
  "default_field_reduction": "per_geometry_then_macro_average",
  "ranking": {
    "metric_id": "overall_score",
    "direction": "higher",
    "decimal_places": 1,
    "rounding": "decimal_half_up",
    "method": "competition"
  },
  "overall_score_composite": {
    "metric_id": "overall_score",
    "operation": "weighted_component_scores",
    "components": [
      {
        "metric_id": "surface_pressure_rel_l2",
        "weight": 1.0,
        "transform": "bounded_error",
        "cap": 100.0
      }
    ],
    "tolerance": 1e-06
  },
  "metrics": [
    {
      "id": "overall_score",
      "unit": "",
      "direction": "higher",
      "kind": "score",
      "equation": "\\sum_k \\alpha_k S_k,\\quad \\sum_k \\alpha_k=1",
      "aggregation": "derived_score_equation",
      "weighting": "dataset_declared_component_weights"
    },
    {
      "id": "surface_pressure_rel_l2",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sqrt{\\sum_i w_i(\\hat{y}_i-y_i)^2}}{\\sqrt{\\sum_i w_i y_i^2}}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "surface_point_dual_area"
    },
    {
      "id": "surface_pressure_equal_entity_rel_l2",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sqrt{\\sum_i(\\hat{y}_i-y_i)^2}}{\\sqrt{\\sum_i y_i^2}}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "surface_points_equal"
    },
    {
      "id": "surface_pressure_rel_l1",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sum_i w_i\\lvert\\hat{y}_i-y_i\\rvert}{\\sum_i w_i\\lvert y_i\\rvert}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "surface_point_dual_area"
    },
    {
      "id": "surface_pressure_r2",
      "unit": "",
      "direction": "higher",
      "kind": "r2",
      "equation": "1-\\frac{\\sum_i(y_i-\\hat{y}_i)^2}{\\sum_i(y_i-\\bar{y})^2}",
      "aggregation": "flatten_all_aligned_field_values",
      "weighting": "surface_points_equal"
    }
  ],
  "profile_panels": [
    {
      "id": "pressure_profiles",
      "required": false,
      "allow_unlisted_stations": false,
      "minimum_points": 2,
      "coordinate_order": "strictly_increasing",
      "station_ids": [
        "upper_body_centerline",
        "underbody_centerline",
        "front_wheelhouse",
        "rear_body_centerline"
      ],
      "quantity_ids": [
        "cp"
      ]
    }
  ],
  "splits": [
    {
      "id": "default",
      "label": "Default",
      "index_file": "splits/default.json",
      "case_count": 1,
      "case_set_id": "default",
      "case_id_status": "prototype_generated",
      "sha256": "6ae0138c4ea9482f36592ed6064c37be44370134cc2b747f3fc8b735780d6334"
    },
    {
      "id": "official_test",
      "label": "Official test",
      "index_file": "splits/official_test.json",
      "case_count": 1154,
      "case_set_id": "official_test",
      "case_id_status": "official",
      "sha256": "2a85162e323815fdc5e6d36e81eed8b981ba5dfbadfe4aad8dcf24cbe222b662"
    }
  ]
}
