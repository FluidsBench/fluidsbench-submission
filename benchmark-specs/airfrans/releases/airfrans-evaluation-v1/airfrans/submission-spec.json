  "ranking": {
    "metric_id": "overall_score",
    "direction": "higher",
    "decimal_places": 1,
    "rounding": "decimal_half_up",
    "method": "competition"
  },
  "overall_score_composite": {
    "metric_id": "overall_score",
    "operation": "weighted_component_scores",
    "components": [
      {
        "metric_id": "surface_pressure_rel_l2",
        "weight": 0.15,
        "transform": "bounded_error",
        "cap": 15.0
      },
      {
        "metric_id": "surface_wall_shear_rel_l2",
        "weight": 0.1,
        "transform": "bounded_error",
        "cap": 20.0
      },
      {
        "metric_id": "flow_domain_velocity_rel_l2",
        "weight": 0.15,
        "transform": "bounded_error",
        "cap": 12.0
      },
      {
        "metric_id": "flow_domain_pressure_rel_l2",
        "weight": 0.1,
        "transform": "bounded_error",
        "cap": 15.0
      },
      {
        "metric_id": "cd_r2",
        "weight": 0.15,
        "transform": "bounded_quality"
      },
      {
        "metric_id": "cl_r2",
        "weight": 0.1,
        "transform": "bounded_quality"
      },
      {
        "metric_id": "velocity_profile_r2",
        "weight": 0.25,
        "transform": "bounded_quality"
      }
    ],
    "tolerance": 1e-06
  },
  "component_score_groups": {
    "operation": "normalized_weighted_component_scores",
    "groups": [
      {
        "metric_id": "field_score",
        "component_metric_ids": [
          "surface_pressure_rel_l2",
          "surface_wall_shear_rel_l2",
          "flow_domain_velocity_rel_l2",
          "flow_domain_pressure_rel_l2"
        ]
      },
      {
        "metric_id": "force_score",
        "component_metric_ids": [
          "cd_r2",
          "cl_r2"
        ]
      },
      {
        "metric_id": "diagnostic_score",
        "component_metric_ids": [
          "velocity_profile_r2"
        ]
      }
    ],
    "tolerance": 1e-06
  },
  "metrics": [
    {
      "id": "overall_score",
      "unit": "",
      "direction": "higher",
      "kind": "score",
      "equation": "\\sum_k \\alpha_k S_k,\\quad \\sum_k \\alpha_k=1",
      "aggregation": "derived_score_equation",
      "weighting": "dataset_declared_component_weights"
    },
    {
      "id": "field_score",
      "unit": "",
      "direction": "higher",
      "kind": "score",
      "equation": "\\frac{\\sum_{j\\in F}\\alpha_j S_j}{\\sum_{j\\in F}\\alpha_j}",
      "aggregation": "derived_score_equation",
      "weighting": "dataset_declared_component_weights"
    },
    {
      "id": "force_score",
      "unit": "",
      "direction": "higher",
      "kind": "score",
      "equation": "\\frac{\\sum_{j\\in C}\\alpha_j S_j}{\\sum_{j\\in C}\\alpha_j}",
      "aggregation": "derived_score_equation",
      "weighting": "dataset_declared_component_weights"
    },
    {
      "id": "diagnostic_score",
      "unit": "",
      "direction": "higher",
      "kind": "score",
      "equation": "\\frac{\\sum_{j\\in D}\\alpha_j S_j}{\\sum_{j\\in D}\\alpha_j}",
      "aggregation": "derived_score_equation",
      "weighting": "dataset_declared_component_weights"
    },
    {
      "id": "surface_pressure_rel_l2",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sqrt{\\sum_i w_i(\\hat{y}_i-y_i)^2}}{\\sqrt{\\sum_i w_i y_i^2}}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "boundary_point_dual_length",
      "domain_label": "one_dimensional_airfoil_curve"
    },
    {
      "id": "surface_pressure_equal_entity_rel_l2",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sqrt{\\sum_i(\\hat{y}_i-y_i)^2}}{\\sqrt{\\sum_i y_i^2}}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "boundary_nodes_equal",
      "domain_label": "one_dimensional_airfoil_curve"
    },
    {
      "id": "surface_wall_shear_rel_l2",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sqrt{\\sum_i w_i(\\hat{y}_i-y_i)^2}}{\\sqrt{\\sum_i w_i y_i^2}}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "boundary_point_dual_length",
      "domain_label": "one_dimensional_airfoil_curve"
    },
    {
      "id": "surface_wall_shear_equal_entity_rel_l2",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sqrt{\\sum_i(\\hat{y}_i-y_i)^2}}{\\sqrt{\\sum_i y_i^2}}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "boundary_nodes_equal",
      "domain_label": "one_dimensional_airfoil_curve"
    },
    {
      "id": "flow_domain_velocity_rel_l2",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sqrt{\\sum_i(\\hat{y}_i-y_i)^2}}{\\sqrt{\\sum_i y_i^2}}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "interior_nodes_equal",
      "domain_label": "two_dimensional_flow_domain"
    },
    {
      "id": "flow_domain_velocity_physical_rel_l2",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sqrt{\\sum_i w_i(\\hat{y}_i-y_i)^2}}{\\sqrt{\\sum_i w_i y_i^2}}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "interior_point_dual_area",
      "domain_label": "two_dimensional_flow_domain"
    },
    {
      "id": "flow_domain_pressure_rel_l2",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sqrt{\\sum_i(\\hat{y}_i-y_i)^2}}{\\sqrt{\\sum_i y_i^2}}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "interior_nodes_equal",
      "domain_label": "two_dimensional_flow_domain"
    },
    {
      "id": "flow_domain_pressure_physical_rel_l2",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sqrt{\\sum_i w_i(\\hat{y}_i-y_i)^2}}{\\sqrt{\\sum_i w_i y_i^2}}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "interior_point_dual_area",
      "domain_label": "two_dimensional_flow_domain"
    },
    {
      "id": "surface_pressure_rel_l1",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sum_i w_i\\lvert\\hat{y}_i-y_i\\rvert}{\\sum_i w_i\\lvert y_i\\rvert}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "boundary_point_dual_length",
      "domain_label": "one_dimensional_airfoil_curve"
    },
    {
      "id": "surface_wall_shear_rel_l1",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sum_i w_i\\lvert\\hat{y}_i-y_i\\rvert}{\\sum_i w_i\\lvert y_i\\rvert}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "boundary_point_dual_length",
      "domain_label": "one_dimensional_airfoil_curve"
    },
    {
      "id": "flow_domain_velocity_rel_l1",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sum_i\\lvert\\hat{y}_i-y_i\\rvert}{\\sum_i\\lvert y_i\\rvert}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "interior_nodes_equal",
      "domain_label": "two_dimensional_flow_domain"
    },
    {
      "id": "flow_domain_pressure_rel_l1",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sum_i\\lvert\\hat{y}_i-y_i\\rvert}{\\sum_i\\lvert y_i\\rvert}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "interior_nodes_equal",
      "domain_label": "two_dimensional_flow_domain"
    },
    {
      "id": "velocity_profile_r2",
      "unit": "",
      "direction": "higher",
      "kind": "r2",
      "equation": "\\frac{1}{|S||Q|}\\sum_{s\\in S}\\sum_{q\\in Q}\\operatorname{clip}_{[0,1]}\\left(1-\\frac{\\sum_{c,i}(y_{c,s,q,i}-\\hat{y}_{c,s,q,i})^2}{\\sum_{c,i}(y_{c,s,q,i}-\\bar{y}_{s,q})^2}\\right)",
      "aggregation": "equal_station_equal_quantity_mean_bounded_r2_across_split",
      "weighting": "stations_equal_quantities_equal_samples_within_each_station_quantity_group"
    },
    {
      "id": "cd_r2",
      "unit": "",
      "direction": "higher",
      "kind": "r2",
      "equation": "1-\\frac{\\sum_i(y_i-\\hat{y}_i)^2}{\\sum_i(y_i-\\bar{y})^2}",
      "aggregation": "all_test_cases",
      "weighting": "cases_equal"
    },
    {
      "id": "cl_r2",
      "unit": "",
      "direction": "higher",
      "kind": "r2",
      "equation": "1-\\frac{\\sum_i(y_i-\\hat{y}_i)^2}{\\sum_i(y_i-\\bar{y})^2}",
      "aggregation": "all_test_cases",
      "weighting": "cases_equal"
    },
    {
      "id": "c_drag_mae",
      "unit": "",
      "direction": "lower",
      "kind": "error",
      "equation": "\\frac{1}{N}\\sum_i\\lvert\\hat{y}_i-y_i\\rvert",
      "aggregation": "all_test_cases",
      "weighting": "cases_equal"
    },
    {
      "id": "c_lift_mae",
      "unit": "",
      "direction": "lower",
      "kind": "error",
      "equation": "\\frac{1}{N}\\sum_i\\lvert\\hat{y}_i-y_i\\rvert",
      "aggregation": "all_test_cases",
      "weighting": "cases_equal"
    }
  ],
