    "force_convention": {
      "reference_area_m2": 0.112,
      "reference_area_source": "constant_reference_area_force_mom_csv",
      "axes": {
        "drag": "+x",
        "lift": "+y",
        "side": "+z"
      },
      "axes_note": "The vertical axis is +y. The body sits on a ground plane at y=0 spanning y in [0, 0.343] and is laterally symmetric about z=0. Mapping lift to +z collapses cl from about 0.49 to about -0.01.",
      "truth_source": "native_field_integration",
      "audit_reference": "published_force_mom_csv",
      "audit_note": "Truth and prediction are integrated identically so a perfect prediction scores R^2 = 1; the published CSV bounds the truth integration rather than defining it."
    },
