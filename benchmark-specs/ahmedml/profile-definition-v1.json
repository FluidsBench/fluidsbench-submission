      "transform": "Ux / U_infinity",
      "stations": [
        {
          "station_id": "wake_vertical_x_0p25_l",
          "coordinate_id": "z_over_h",
          "coordinate_range": [
            0.0,
            2.0
          ],
          "target_rule": "x=0.25*L, y=0, z=t*H"
        },
        {
          "station_id": "wake_vertical_x_0p50_l",
          "coordinate_id": "z_over_h",
          "coordinate_range": [
            0.0,
            2.0
          ],
          "target_rule": "x=0.50*L, y=0, z=t*H"
