{
  "schema": "hiliftaeroml-native-profile-format-contract-v1",
  "schema_version": 1,
  "dataset_id": "hiliftaeroml",
  "contract_id": "hiliftaeroml-native-profile-predictions-v1-candidate",
  "format": "fluidsbench-hiliftaeroml-native-profile-chunks-v1-candidate",
  "status": "candidate_owner_review_required",
  "container": {
    "kind": "numpy_npz",
    "allow_pickle": false,
    "member_format": "npy",
    "member_order": "contract_order",
    "zip_timestamp": "1980-01-01T00:00:00",
    "compression": "deflate_level_9"
  },
  "surface_cp": {
    "source_schema": "hilift_native_cp_line_metrics_v3",
    "prediction_basis": "Cp=(P-p_inf)/q_inf",
    "coordinate_frame": "native_body_frame",
    "coordinate_unit": "in",
    "station_rows": [
      "A",
      "B",
      "C",
      "D",
      "E",
      "F",
      "G",
      "H",
      "I",
      "J"
    ],
    "required_source_arrays": [
      "branch_closed",
      "branch_component_code",
      "branch_graph_component_code",
      "branch_plane_piece_code",
      "branch_row_code",
      "branch_segment_offsets",
      "branch_side_code",
      "branch_topology_patch_code",
      "branch_vertex_ids",
      "branch_vertex_offsets",
      "cut_xyz_in",
      "prediction_cp",
      "segment_lengths_in",
      "segment_plane_piece_code",
      "segment_vertex_ids",
      "truth_cp"
    ],
    "published_prediction_arrays": [
      "branch_closed",
      "branch_component_code",
      "branch_graph_component_code",
      "branch_plane_piece_code",
      "branch_row_code",
      "branch_segment_offsets",
      "branch_side_code",
      "branch_topology_patch_code",
      "branch_vertex_ids",
      "branch_vertex_offsets",
      "cut_xyz_in",
      "prediction_cp",
      "segment_lengths_in",
      "segment_plane_piece_code",
      "segment_vertex_ids"
    ],
    "topology_rules": {
      "graph_identity": "branch_row_code plus branch_graph_component_code",
      "branch_vertices": "branch_vertex_ids sliced by branch_vertex_offsets",
      "branch_segments": "contract-global segment arrays sliced by branch_segment_offsets",
      "disconnected_graphs_must_remain_disconnected": true,
      "new_scoring_edges_forbidden": true,
      "segment_weight": "segment_lengths_in"
    }
  },
  "volume_velocity": {
    "source_schema": "hilift_native_velocity_profile_metrics_v2",
    "prediction_basis": "velocity divided by |U_inf|",
    "coordinate_frame": "native_body_frame",
    "coordinate_unit": "in",
    "station_order": [
      "B.2",
      "B.3",
      "C.1",
      "C.2",
      "C.3"
    ],
    "rows_per_station": 801,
    "required_source_arrays": [
      "requested_xyz_in",
      "valid_mask",
      "station_names",
      "station_row_offsets",
      "line_length_weights_in",
      "predicted_velocity_nd",
      "reference_velocity_nd",
      "predicted_velocity_physical",
      "reference_velocity_physical",
      "predicted_velocity_dimensional",
      "reference_velocity_dimensional",
      "predicted_velocity_magnitude_nd",
      "reference_velocity_magnitude_nd",
      "u_x_over_U_inf_pred",
      "u_x_over_U_inf_reference",
      "u_y_over_U_inf_pred",
      "u_y_over_U_inf_reference",
      "u_z_over_U_inf_pred",
      "u_z_over_U_inf_reference",
      "speed_over_U_inf_pred",
      "speed_over_U_inf_reference",
      "u_inf_magnitude_physical",
      "support_raw_point_ids",
      "support_compact_point_ids",
      "predicted_velocity_support_nd",
      "reference_velocity_support_nd",
      "predicted_velocity_support_physical",
      "reference_velocity_support_physical",
      "u_inf_vector_physical",
      "velocity_physical_units",
      "velocity_nondimensionalization",
      "context_ceiling",
      "partition_seed",
      "run_fingerprint"
    ],
    "published_prediction_arrays": [
      "requested_xyz_in",
      "valid_mask",
      "station_names",
      "station_row_offsets",
      "line_length_weights_in",
      "predicted_velocity_nd",
      "predicted_velocity_magnitude_nd",
      "support_raw_point_ids",
      "support_compact_point_ids",
      "predicted_velocity_support_nd",
      "u_inf_vector_physical",
      "velocity_nondimensionalization",
      "context_ceiling",
      "partition_seed",
      "run_fingerprint"
    ],
    "gap_rules": {
      "validity_mask_is_authoritative": true,
      "invalid_rows_remain_serialized": true,
      "invalid_prediction_values_are_nan": true,
      "invalid_line_length_weights_are_zero": true,
      "interpolation_across_invalid_runs_forbidden": true,
      "station_weight": "line_length_weights_in"
    }
  },
  "privacy_and_truth_boundary": {
    "prediction_chunks_include_ground_truth": false,
    "truth_arrays_are_required_only_in_the_evaluator_native_source_for_validation": true,
    "profile_ground_truth_is_a_separate_benchmark_owned_release": true,
    "participant_predictions_can_be_scored_without_disclosing_hidden_truth": true
  },
  "aggregation": {
    "cp_r2": "center truth independently within every physical connected cut graph, pool graph SSE and SST within a case, then macro-average complete-case R2 equally",
    "velocity_r2": "center truth independently within B.2, B.3, C.1, C.2, and C.3, pool station SSE and SST within a case, then macro-average complete-case R2 equally"
  },
  "activation_gate": "Owner approval plus a complete profile-ground-truth release bound to this exact contract SHA-256 are required before submissions open."
}
