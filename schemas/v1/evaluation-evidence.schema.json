{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluidsbench.org/schemas/v1/evaluation-evidence.schema.json",
  "title": "FluidsBench evaluation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "dataset_id",
    "split_id",
    "reference_version",
    "code_revision",
    "command",
    "generated_at",
    "status",
    "metric_values",
    "profile_index_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "submission_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "split_id": {"type": "string", "minLength": 1},
    "reference_version": {"type": "string", "minLength": 1},
    "code_revision": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1, "maxLength": 2000},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["prototype_dummy_data", "pre_release_reference", "submitted_evaluation"]},
    "metric_values": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number"}
    },
    "profile_index_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "regional_diagnostics_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_archive_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_package_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "notes": {"type": "string"}
  }
}
