{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluidsbench.org/schemas/v1/maintainer-replay.schema.json",
  "title": "FluidsBench historical maintainer record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "submission_id",
    "dataset_id",
    "split_id",
    "reference_version",
    "replayed_by",
    "replayed_at",
    "independence",
    "code",
    "model_artifact",
    "environment",
    "command",
    "status",
    "metric_values",
    "metric_abs_tolerance",
    "reviewed_submission_sha256",
    "submitted_profile_index_sha256",
    "replayed_profile_index_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "open-reproducibility-1.0"},
    "submission_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "split_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
    "reference_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "replayed_by": {"type": "string", "minLength": 1, "maxLength": 160},
    "replayed_at": {"type": "string", "format": "date-time"},
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_of_submitter", "conflict_of_interest_disclosure"],
      "properties": {
        "independent_of_submitter": {"const": true},
        "conflict_of_interest_disclosure": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_url", "commit"],
      "properties": {
        "repository_url": {"type": "string", "pattern": "^https://", "format": "uri"},
        "commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"}
      }
    },
    "model_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://", "format": "uri"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "sha256"],
      "properties": {
        "kind": {"enum": ["container", "lockfile"]},
        "url": {"type": "string", "pattern": "^https://", "format": "uri"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "command": {"type": "string", "minLength": 1, "maxLength": 2000},
    "status": {"const": "reproduced"},
    "metric_values": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number"}
    },
    "metric_abs_tolerance": {"type": "number", "minimum": 0, "maximum": 0.001},
    "reviewed_submission_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "submitted_profile_index_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "replayed_profile_index_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "notes": {"type": "string"}
  }
}
