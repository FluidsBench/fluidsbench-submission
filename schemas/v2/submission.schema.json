{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluidsbench.org/schemas/v2/submission.schema.json",
  "title": "FluidsBench submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "submission_id",
    "model",
    "model_type",
    "model_types",
    "training_regime",
    "target_data_used",
    "external_pretraining",
    "pretraining_data",
    "dataset",
    "dataset_id",
    "dataset_version",
    "split",
    "split_id",
    "case_set_id",
    "split_sha256",
    "parameter_count_millions",
    "submitter_name",
    "institution",
    "paper_url",
    "code_url",
    "submitted_at",
    "evaluation",
    "reproducibility",
    "metric_values",
    "profile_data"
  ],
  "properties": {
    "$schema": {"const": "https://fluidsbench.org/schemas/v2/submission.schema.json"},
    "schema_version": {"const": "2.0"},
    "submission_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "model": {"type": "string", "minLength": 1, "maxLength": 120},
    "model_type": {"type": "string", "minLength": 1},
    "model_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "training_regime": {"enum": ["from_scratch", "pretrained_zero_shot", "pretrained_official_train", "other"]},
    "training_regime_explanation": {"type": "string", "minLength": 1},
    "target_data_used": {"enum": ["none", "official_train", "other"]},
    "external_pretraining": {"type": "boolean"},
    "pretraining_data": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": true,
            "required": ["name"],
            "properties": {"name": {"type": "string", "minLength": 1}}
          }
        ]
      }
    },
    "dataset": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "dataset_version": {"type": "string", "minLength": 1},
    "split": {"type": "string", "minLength": 1},
    "split_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
    "case_set_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
    "split_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parameter_count_millions": {"type": ["number", "null"], "minimum": 0},
    "methodology": {"type": "object"},
    "submitter_name": {"type": "string", "minLength": 1},
    "institution": {"type": "string", "minLength": 1},
    "paper_url": {"type": "string", "pattern": "^$|^https?://"},
    "code_url": {"type": "string", "pattern": "^$|^https?://"},
    "submitted_at": {"type": "string", "format": "date"},
    "note": {"type": "string"},
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_version", "code_revision", "command", "evidence_file", "evidence_sha256"],
      "properties": {
        "reference_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "code_revision": {"type": "string", "minLength": 1, "maxLength": 160},
        "command": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_file": {"const": "evaluation-evidence.json"},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "access",
        "public_test_data_use",
        "result_data_license_spdx",
        "code",
        "model_artifact",
        "environment",
        "artifact_documentation_url"
      ],
      "properties": {
        "contract_version": {"const": "open-reproducibility-2.0"},
        "access": {"const": "public"},
        "public_test_data_use": {"const": "evaluation_only"},
        "result_data_license_spdx": {
          "enum": ["CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0", "ODC-BY-1.0", "ODbL-1.0"]
        },
        "code": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository_url", "commit", "license_spdx"],
          "properties": {
            "repository_url": {"type": "string", "pattern": "^https://", "format": "uri"},
            "commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
            "license_spdx": {
              "enum": [
                "Apache-2.0",
                "MIT",
                "BSD-2-Clause",
                "BSD-3-Clause",
                "ISC",
                "MPL-2.0",
                "EPL-2.0",
                "GPL-2.0-only",
                "GPL-2.0-or-later",
                "GPL-3.0-only",
                "GPL-3.0-or-later",
                "LGPL-2.1-only",
                "LGPL-2.1-or-later",
                "LGPL-3.0-only",
                "LGPL-3.0-or-later",
                "AGPL-3.0-only",
                "AGPL-3.0-or-later"
              ]
            }
          }
        },
        "model_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256", "license_spdx"],
          "properties": {
            "url": {"type": "string", "pattern": "^https://", "format": "uri"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "license_spdx": {
              "enum": [
                "Apache-2.0",
                "MIT",
                "BSD-2-Clause",
                "BSD-3-Clause",
                "ISC",
                "MPL-2.0",
                "CC0-1.0",
                "CC-BY-4.0",
                "CC-BY-SA-4.0"
              ]
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "sha256"],
          "properties": {
            "kind": {"enum": ["container", "lockfile"]},
            "url": {"type": "string", "pattern": "^https://", "format": "uri"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "artifact_documentation_url": {"type": "string", "pattern": "^https://", "format": "uri"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"const": "approved"},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date"},
        "pull_request_url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+$"},
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_file", "evidence_sha256"],
          "properties": {
            "evidence_file": {"const": "maintainer-validation.json"},
            "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "note": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
          "then": {"required": ["approved_by", "approved_at", "pull_request_url", "validation"]}
        }
      ]
    },
    "metric_values": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number"}
    },
    "profile_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "index_file",
        "case_count",
        "case_set_id",
        "profile_ground_truth_release_id",
        "profile_ground_truth_manifest_sha256"
      ],
      "properties": {
        "format": {"const": "fluidsbench-profile-chunks-v1"},
        "index_file": {"const": "profiles/index.json"},
        "case_count": {"type": "integer", "minimum": 1},
        "case_set_id": {"type": "string", "minLength": 1},
        "profile_ground_truth_release_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "profile_ground_truth_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
