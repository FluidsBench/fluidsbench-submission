{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluidsbench.org/schemas/releases/claim-index.schema.json",
  "title": "FluidsBench result-claim index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "release_id",
    "release_status",
    "feed_file",
    "feed_sha256",
    "ranking_contract",
    "record_count",
    "eligible_record_count",
    "records"
  ],
  "properties": {
    "$schema": {"const": "https://fluidsbench.org/schemas/releases/claim-index.schema.json"},
    "schema_version": {"const": "1.0"},
    "release_id": {"type": "string", "minLength": 1},
    "release_status": {"enum": ["prototype_dummy_data", "official"]},
    "feed_file": {"const": "leaderboard/all.json"},
    "feed_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ranking_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "scope", "method", "tie_sequence_example", "comparison", "rounding"],
      "properties": {
        "version": {"const": "1.0"},
        "scope": {"const": ["release_id", "dataset_id", "split_id"]},
        "method": {"const": "competition"},
        "tie_sequence_example": {"const": [1, 2, 2, 4]},
        "comparison": {"const": "rounded_metric_value"},
        "rounding": {"const": "decimal_half_up"}
      }
    },
    "record_count": {"type": "integer", "minimum": 0},
    "eligible_record_count": {"type": "integer", "minimum": 0},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "submission_id", "series_id", "version", "dataset_id", "split_id", "eligible", "file", "sha256"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "submission_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
          "series_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
          "version": {"type": "integer", "minimum": 1},
          "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "split_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
          "eligible": {"type": "boolean"},
          "file": {
            "type": "string",
            "pattern": "^leaderboard/claims/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9_]*/[a-z0-9][a-z0-9-]{2,79}\\.json$"
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"release_status": {"const": "prototype_dummy_data"}}},
      "then": {
        "properties": {
          "eligible_record_count": {"const": 0},
          "records": {"items": {"properties": {"eligible": {"const": false}}}}
        }
      }
    },
    {
      "if": {"properties": {"release_status": {"const": "official"}}},
      "then": {
        "properties": {
          "records": {"items": {"properties": {"eligible": {"const": true}}}}
        }
      }
    }
  ]
}
