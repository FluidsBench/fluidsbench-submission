{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluidsbench.org/schemas/releases/result-claim.schema.json",
  "title": "FluidsBench immutable result claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "claim_id",
    "release",
    "result",
    "ranking",
    "eligibility",
    "result_permalink",
    "claim_record_url",
    "bindings"
  ],
  "properties": {
    "$schema": { "const": "https://fluidsbench.org/schemas/releases/result-claim.schema.json" },
    "schema_version": { "const": "1.0" },
    "claim_id": { "type": "string", "minLength": 1 },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "published_at", "archive_url", "release_view_url"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["prototype_dummy_data", "official"] },
        "published_at": { "type": "string", "format": "date-time" },
        "archive_url": { "type": ["string", "null"], "format": "uri" },
        "release_view_url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submission_id", "result_revision", "model", "dataset", "dataset_id", "split", "split_id", "submission_schema_version"],
      "properties": {
        "submission_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "result_revision": { "$ref": "#/$defs/result_revision" },
        "model": { "type": "string", "minLength": 1 },
        "dataset": { "type": "string", "minLength": 1 },
        "dataset_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "split": { "type": "string", "minLength": 1 },
        "split_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$" },
        "prediction_scope": { "enum": ["surface_and_volume", "surface_only"] },
        "submission_schema_version": { "enum": ["1.0", "2.0", "3.0"] }
      }
    },
    "ranking": { "$ref": "#/$defs/ranking" },
    "eligibility": { "$ref": "#/$defs/eligibility" },
    "result_permalink": { "type": ["string", "null"], "format": "uri" },
    "claim_record_url": { "type": ["string", "null"], "format": "uri" },
    "prediction_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sharing", "declared_artifact_count", "maintainer_check_status", "checked_artifact_count"],
      "properties": {
        "sharing": { "enum": ["not_declared", "declared"] },
        "declared_artifact_count": { "type": "integer", "minimum": 0 },
        "maintainer_check_status": { "enum": ["not_recorded", "recorded"] },
        "checked_artifact_count": { "type": "integer", "minimum": 0 }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "source_submission", "evaluation_evidence", "profile_index"],
      "properties": {
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["feed_file", "feed_sha256", "row_index"],
          "properties": {
            "feed_file": { "const": "leaderboard/all.json" },
            "feed_sha256": { "$ref": "#/$defs/sha256" },
            "row_index": { "type": "integer", "minimum": 0 }
          }
        },
        "source_submission": { "$ref": "#/$defs/file_binding" },
        "evaluation_evidence": { "$ref": "#/$defs/file_binding" },
        "profile_index": { "$ref": "#/$defs/file_binding" },
        "scoring_support": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release_id", "manifest_url", "manifest_sha256"],
          "properties": {
            "release_id": { "type": "string", "minLength": 1 },
            "manifest_url": { "type": "string", "pattern": "^https://", "format": "uri" },
            "manifest_sha256": { "$ref": "#/$defs/sha256" },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        "spatial_discretization": { "$ref": "#/$defs/file_binding" },
        "discretization_cases": { "$ref": "#/$defs/file_binding" },
        "case_metrics": { "$ref": "#/$defs/file_binding" },
        "regional_diagnostics": { "$ref": "#/$defs/file_binding" },
        "prediction_artifact_checks": { "$ref": "#/$defs/file_binding" },
        "maintainer_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "status", "validation_scope", "model_execution", "metric_recomputation"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "status": { "const": "validated" },
            "validation_scope": { "const": "submitted_data_only" },
            "model_execution": { "const": "not_performed" },
            "metric_recomputation": { "const": "not_performed" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "release": {
            "properties": { "status": { "const": "prototype_dummy_data" } },
            "required": ["status"]
          }
        },
        "required": ["release"]
      },
      "then": {
        "properties": {
          "eligibility": {
            "properties": {
              "academic_citation": { "const": false },
              "promotion": { "const": false },
              "reason_code": {
                "enum": ["prototype_dummy_data", "pre_release_reference"]
              }
            }
          },
          "result_permalink": { "type": "null" },
          "claim_record_url": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release": {
            "properties": { "status": { "const": "official" } },
            "required": ["status"]
          }
        },
        "required": ["release"]
      },
      "then": {
        "properties": {
          "release": {
            "properties": {
              "archive_url": { "type": "string", "format": "uri" },
              "release_view_url": { "type": "string", "format": "uri" }
            }
          },
          "eligibility": {
            "properties": {
              "academic_citation": { "const": true },
              "promotion": { "const": true },
              "reason_code": { "const": "approved_submitted_data_result" }
            }
          },
          "result_permalink": { "type": "string", "format": "uri" },
          "claim_record_url": { "type": "string", "format": "uri" },
          "bindings": { "required": ["maintainer_validation"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": { "submission_schema_version": { "const": "3.0" } },
            "required": ["submission_schema_version"]
          }
        },
        "required": ["result"]
      },
      "then": {
        "required": ["prediction_artifacts"],
        "properties": {
          "bindings": {
            "required": ["scoring_support", "spatial_discretization", "discretization_cases", "case_metrics"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prediction_artifacts": {
            "properties": { "maintainer_check_status": { "const": "recorded" } },
            "required": ["maintainer_check_status"]
          }
        },
        "required": ["prediction_artifacts"]
      },
      "then": {
        "properties": {
          "bindings": { "required": ["prediction_artifact_checks"] }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "result_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_id",
        "version",
        "supersedes",
        "change_summary",
        "is_latest",
        "latest_submission_id",
        "version_count"
      ],
      "properties": {
        "series_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "version": { "type": "integer", "minimum": 1 },
        "supersedes": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
            { "type": "null" }
          ]
        },
        "change_summary": { "type": ["string", "null"], "minLength": 1, "maxLength": 2000 },
        "is_latest": { "const": true },
        "latest_submission_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "version_count": { "type": "integer", "minimum": 1 }
      }
    },
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "value",
        "ranked_value",
        "display_value",
        "unit",
        "direction",
        "decimal_places",
        "rounding",
        "method",
        "rank",
        "ranked_result_count",
        "tied",
        "tie_count"
      ],
      "properties": {
        "metric_id": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "ranked_value": { "type": "number" },
        "display_value": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" },
        "unit": { "type": "string" },
        "direction": { "enum": ["higher", "lower"] },
        "decimal_places": { "type": "integer", "minimum": 0, "maximum": 12 },
        "rounding": { "const": "decimal_half_up" },
        "method": { "const": "competition" },
        "rank": { "type": "integer", "minimum": 1 },
        "ranked_result_count": { "type": "integer", "minimum": 1 },
        "tied": { "type": "boolean" },
        "tie_count": { "type": "integer", "minimum": 1 }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["academic_citation", "promotion", "reason_code", "reason"],
      "properties": {
        "academic_citation": { "type": "boolean" },
        "promotion": { "type": "boolean" },
        "reason_code": {
          "enum": ["prototype_dummy_data", "pre_release_reference", "approved_submitted_data_result", "not_approved_and_validated"]
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
