{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluidsbench.org/schemas/v3/maintainer-validation.schema.json",
  "title": "FluidsBench v3 maintainer validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_version",
    "submission_id",
    "dataset_id",
    "split_id",
    "case_set_id",
    "reference_version",
    "profile_ground_truth_release_id",
    "profile_ground_truth_manifest_sha256",
    "scoring_support_release_id",
    "scoring_support_manifest_sha256",
    "validated_by",
    "validated_at",
    "status",
    "validation_scope",
    "model_execution",
    "metric_recomputation",
    "reviewed_submission_sha256",
    "evaluation_evidence_sha256",
    "profile_index_sha256",
    "discretization_sha256",
    "case_metrics_sha256"
  ],
  "properties": {
    "$schema": { "const": "https://fluidsbench.org/schemas/v3/maintainer-validation.schema.json" },
    "schema_version": { "const": "3.0" },
    "contract_version": { "const": "open-reproducibility-3.0" },
    "submission_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "dataset_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "split_id": { "$ref": "#/$defs/safe_id" },
    "case_set_id": { "$ref": "#/$defs/safe_id" },
    "reference_version": { "type": "string", "minLength": 1, "maxLength": 160 },
    "profile_ground_truth_release_id": { "$ref": "#/$defs/safe_id" },
    "profile_ground_truth_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "scoring_support_release_id": { "$ref": "#/$defs/safe_id" },
    "scoring_support_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "validated_by": { "type": "string", "minLength": 1, "maxLength": 160 },
    "validated_at": { "type": "string", "format": "date-time" },
    "status": { "const": "validated" },
    "validation_scope": { "const": "submitted_data_only" },
    "model_execution": { "const": "not_performed" },
    "metric_recomputation": { "const": "not_performed" },
    "reviewed_submission_sha256": { "$ref": "#/$defs/sha256" },
    "evaluation_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "profile_index_sha256": { "$ref": "#/$defs/sha256" },
    "discretization_sha256": { "$ref": "#/$defs/sha256" },
    "case_metrics_sha256": { "$ref": "#/$defs/sha256" },
    "regional_diagnostics_sha256": { "$ref": "#/$defs/sha256" },
    "prediction_artifact_checks_sha256": { "$ref": "#/$defs/sha256" },
    "notes": { "type": "string" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,159}$"
    }
  }
}
