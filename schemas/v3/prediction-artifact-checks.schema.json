{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluidsbench.org/schemas/v3/prediction-artifact-checks.schema.json",
  "title": "FluidsBench maintainer-owned prediction artifact checks",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "submission_id", "checks"],
  "properties": {
    "$schema": {
      "const": "https://fluidsbench.org/schemas/v3/prediction-artifact-checks.schema.json"
    },
    "schema_version": { "const": "1.0" },
    "submission_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "dataset_evaluator_recomputation": {
      "$ref": "#/$defs/dataset_evaluator_recomputation"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,159}$"
    },
    "dataset_evaluator_recomputation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "status",
        "evaluator_reference_version",
        "evaluator_code_revision",
        "command",
        "case_count",
        "case_metrics_sha256",
        "nonspatial_metric_ids",
        "nonspatial_values_sha256",
        "prediction_artifact_ids"
      ],
      "properties": {
        "dataset_id": { "$ref": "#/$defs/safe_id" },
        "status": { "const": "complete_native_evaluator_recomputation" },
        "evaluator_reference_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "evaluator_code_revision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "command": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "case_count": { "type": "integer", "minimum": 1 },
        "case_metrics_sha256": { "$ref": "#/$defs/sha256" },
        "nonspatial_metric_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safe_id" }
        },
        "nonspatial_values_sha256": { "$ref": "#/$defs/sha256" },
        "prediction_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safe_id" }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "status",
        "checked_at",
        "checked_by",
        "repository_revision",
        "manifest_sha256",
        "checked_case_count",
        "recomputed_case_count",
        "expected_case_count",
        "metric_recomputation"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/safe_id" },
        "status": {
          "enum": ["not_checked", "accessible", "format_checked", "metrics_recomputed", "failed"]
        },
        "checked_at": { "type": "string", "format": "date-time" },
        "checked_by": { "type": "string", "minLength": 1, "maxLength": 160 },
        "repository_revision": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "checked_case_count": { "type": "integer", "minimum": 0 },
        "recomputed_case_count": { "type": "integer", "minimum": 0 },
        "expected_case_count": { "type": "integer", "minimum": 1 },
        "metric_recomputation": { "enum": ["not_performed", "partial", "performed"] },
        "notes": { "type": "string", "maxLength": 4000 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "metric_recomputation": { "const": "not_performed" } },
            "required": ["metric_recomputation"]
          },
          "then": {
            "properties": {
              "recomputed_case_count": { "const": 0 },
              "status": { "not": { "const": "metrics_recomputed" } }
            }
          }
        },
        {
          "if": {
            "properties": { "metric_recomputation": { "const": "partial" } },
            "required": ["metric_recomputation"]
          },
          "then": {
            "properties": {
              "recomputed_case_count": { "minimum": 1 },
              "status": { "const": "metrics_recomputed" }
            }
          }
        },
        {
          "if": {
            "properties": { "metric_recomputation": { "const": "performed" } },
            "required": ["metric_recomputation"]
          },
          "then": {
            "properties": {
              "recomputed_case_count": { "minimum": 1 },
              "status": { "const": "metrics_recomputed" }
            }
          }
        }
      ]
    }
  }
}
